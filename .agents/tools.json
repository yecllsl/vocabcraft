{
  "$schema": "https://agents.aaif.io/schemas/tools.json",
  "name": "vocabcraft",
  "version": "0.5.4",
  "description": "VocabCraft 词汇学习与制作智能体",
  "tools": [
    {
      "name": "save_vocab",
      "description": "保存词汇记录到本地 JSON 文件",
      "parameters": {
        "type": "object",
        "properties": {
          "vocab_data": {
            "type": "object",
            "description": "词汇数据对象"
          }
        },
        "required": ["vocab_data"]
      }
    },
    {
      "name": "query_vocab",
      "description": "按条件查询词汇",
      "parameters": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "description": "查询过滤条件"
          }
        },
        "required": ["filters"]
      }
    },
    {
      "name": "parse_vocab",
      "description": "AI 结构化解析词汇（词形/音标/词性/释义/例句）",
      "parameters": {
        "type": "object",
        "properties": {
          "image_path": {
            "type": "string",
            "description": "图片路径"
          },
          "text": {
            "type": "string",
            "description": "文本内容"
          },
          "language": {
            "type": "string",
            "description": "语言代码",
            "default": "en"
          }
        }
      }
    },
    {
      "name": "schedule_review",
      "description": "基于遗忘曲线生成复习计划",
      "parameters": {
        "type": "object",
        "properties": {
          "vocab_id": {
            "type": "string",
            "description": "词汇 ID"
          },
          "language": {
            "type": "string",
            "description": "语言代码"
          }
        }
      }
    },
    {
      "name": "generate_quiz",
      "description": "生成考题",
      "parameters": {
        "type": "object",
        "properties": {
          "vocab_id": {
            "type": "string",
            "description": "词汇 ID"
          },
          "quiz_type": {
            "type": "string",
            "description": "考题类型",
            "enum": ["choice", "fill_blank", "spelling"]
          }
        }
      }
    },
    {
      "name": "grade_quiz",
      "description": "评分用户作答并更新 SM-2 记忆状态",
      "parameters": {
        "type": "object",
        "properties": {
          "quiz_id": {
            "type": "string",
            "description": "考题 ID"
          },
          "response": {
            "type": "string",
            "description": "用户作答"
          }
        },
        "required": ["quiz_id", "response"]
      }
    },
    {
      "name": "get_statistics",
      "description": "获取词汇统计信息",
      "parameters": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "语言代码"
          }
        }
      }
    },
    {
      "name": "export_data",
      "description": "导出词汇数据到本地文件",
      "parameters": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "导出格式",
            "enum": ["json", "csv"]
          },
          "filters": {
            "type": "object",
            "description": "导出过滤条件"
          }
        }
      }
    },
    {
      "name": "update_vocab",
      "description": "更新已保存的词汇记录",
      "parameters": {
        "type": "object",
        "properties": {
          "vocab_id": {
            "type": "string",
            "description": "词汇 ID"
          },
          "vocab_data": {
            "type": "object",
            "description": "待更新的词汇字段"
          }
        },
        "required": ["vocab_id", "vocab_data"]
      }
    },
    {
      "name": "delete_vocab",
      "description": "删除词汇记录",
      "parameters": {
        "type": "object",
        "properties": {
          "vocab_id": {
            "type": "string",
            "description": "词汇 ID"
          }
        },
        "required": ["vocab_id"]
      }
    },
    {
      "name": "import_xlsx_vocab",
      "description": "从 .xlsx 批量导入词汇",
      "parameters": {
        "type": "object",
        "properties": {
          "xlsx_path": {
            "type": "string",
            "description": "Excel 文件路径"
          },
          "sheet_name": {
            "type": "string",
            "description": "工作表名（可选）"
          },
          "language": {
            "type": "string",
            "description": "语言代码",
            "default": "en"
          }
        },
        "required": ["xlsx_path"]
      }
    }
  ]
}
