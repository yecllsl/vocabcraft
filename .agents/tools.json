{
  "$schema": "https://agents.aaif.io/schemas/tools.json",
  "name": "vocabcraft-mcp",
  "version": "0.6.1",
  "description": "词汇学习与制作一体 MCP Server",
  "tools": [
    {
      "name": "save_vocab",
      "description": "保存词汇记录到本地 JSON 文件",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "vocab_data": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "vocab_data"
        ],
        "type": "object"
      }
    },
    {
      "name": "query_vocab",
      "description": "按条件查询词汇",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "filters"
        ],
        "type": "object"
      }
    },
    {
      "name": "update_vocab",
      "description": "更新词汇记录",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "vocab_data": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "vocab_data"
        ],
        "type": "object"
      }
    },
    {
      "name": "delete_vocab",
      "description": "删除词汇记录",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "vocab_id": {
            "type": "string"
          }
        },
        "required": [
          "vocab_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "parse_vocab",
      "description": "AI 结构化解析词汇（词形/音标/词性/释义/例句）。\n三模式优先级：对话多模态（无参数）> 本地路径多模态（image_path）> 文本模式（text）。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "image_path": {
            "default": "",
            "type": "string"
          },
          "text": {
            "default": "",
            "type": "string"
          },
          "language": {
            "default": "en",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "schedule_review",
      "description": "基于遗忘曲线生成复习计划（language 为空则不按语种过滤）",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "vocab_id": {
            "default": "",
            "type": "string"
          },
          "language": {
            "default": "",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "generate_quiz",
      "description": "为指定词汇生成考题（选择/填空/拼写/释义）",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "vocab_id": {
            "type": "string"
          },
          "quiz_type": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "vocab_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "grade_quiz",
      "description": "评分并按 SM-2 更新词汇记忆状态",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "quiz_id": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        },
        "required": [
          "quiz_id",
          "response"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_statistics",
      "description": "统计词汇量、掌握度、题型分布",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "group_by": {
            "type": "string"
          }
        },
        "required": [
          "group_by"
        ],
        "type": "object"
      }
    },
    {
      "name": "export_data",
      "description": "导出词汇数据为 JSON/CSV",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "json",
            "type": "string"
          },
          "filters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object"
      }
    },
    {
      "name": "import_xlsx_vocab",
      "description": "从 .xlsx 文件批量导入词汇",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "xlsx_path": {
            "type": "string"
          },
          "sheet_name": {
            "default": "",
            "type": "string"
          },
          "language": {
            "default": "en",
            "type": "string"
          }
        },
        "required": [
          "xlsx_path"
        ],
        "type": "object"
      }
    }
  ]
}
