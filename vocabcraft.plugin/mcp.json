{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vocabcraft-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "${PLUGIN_ROOT}/../vocabcraft-mcp",
        "vocabcraft-mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
